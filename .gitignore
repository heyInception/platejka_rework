# Closed by default: this repository lives inside a working WordPress site.
/*
!/.gitignore
!/README.md
!/THIRD_PARTY_LICENSES.md

# Root Composer, Node and test/tool configuration, when introduced.
!/composer.json
!/composer.lock
!/package.json
!/package-lock.json
!/npm-shrinkwrap.json
!/yarn.lock
!/pnpm-lock.yaml
!/.nvmrc
!/.node-version
!/tsconfig*.json
!/phpunit.xml*
!/phpcs.xml*
!/phpstan.neon*
!/playwright.config.*
!/vitest.config.*
!/eslint.config.*
!/.eslintrc*
!/.prettierrc*
!/.prettierignore
!/.editorconfig

!/docs/
!/docs/**
!/tests/
!/tests/**
!/themes/
/themes/*
!/themes/platejka_rework/
!/themes/platejka_rework/**
!/plugins/
/plugins/*
!/plugins/platejka-core/
!/plugins/platejka-core/**

# Generated dependencies, caches, secrets and database artifacts in allowed trees.
**/node_modules/
**/vendor/
**/.cache/
**/.phpunit.cache/
**/.phpunit.result.cache
**/coverage/
**/playwright-report/
**/test-results/
**/.env
**/.env.*
**/*.log
**/*.sql
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/Thumbs.db
**/.DS_Store
